# ------------------------------------------------------------------------------
# Framelock — Meta AI Model API Configuration (Muse & SAM 3.1)
# ------------------------------------------------------------------------------
# API Key and Base URL for Meta AI / Muse & SAM 3.1 Model Inference Endpoints.
# Leave blank or "mock" during local evaluation to use the built-in HTML5 Canvas
# & deterministic fixture engine.
VITE_META_AI_API_KEY="your_meta_ai_api_key_here"
VITE_META_API_BASE_URL="https://api.meta.ai/v1"
META_API_KEY="your_meta_ai_api_key_here"

# Model Identifiers (Override if using custom fine-tuned or regional endpoints)
VITE_MUSE_VOICE_MODEL="muse-voice-transcribe-1.0"
VITE_MUSE_SPARK_MODEL="muse-spark-1.3"
VITE_MUSE_IMAGE_MODEL="muse-image-1.0"
VITE_SAM3_MODEL="sam-3.1"

# Modal.com Cloud GPU Credentials (Hackathon Partner)
MODAL_TOKEN_ID=ak-xxxxxxxxxxxxxxxxxxxx
MODAL_TOKEN_SECRET=as-xxxxxxxxxxxxxxxxxxxx
MODAL_VIDEO_ENDPOINT=https://<workspace>--anchorshot-video-generate.us-east.modal.run

# Shot planner provider. Default "fixture" never calls a model.
# "openai-compatible" works with any chat endpoint (Meta gateway, Baseten, local).
PLANNER_PROVIDER="fixture"
PLANNER_BASE_URL=""
PLANNER_API_KEY=""
PLANNER_MODEL=""

# Storyboard image provider. Unset keeps the offline canvas frames.
# "openai-compatible" works with any /images/generations endpoint returning base64.
IMAGE_PROVIDER=""
IMAGE_BASE_URL=""
IMAGE_API_KEY=""
IMAGE_MODEL=""
IMAGE_SIZE="1024x576"

# Voice transcription provider. Unset keeps the browser's speech recognition.
# "openai-compatible" works with any /audio/transcriptions endpoint;
# "elevenlabs" uses ELEVENLABS_API_KEY with Scribe (TRANSCRIBE_MODEL defaults to scribe_v2).
TRANSCRIBE_PROVIDER=""
TRANSCRIBE_BASE_URL=""
TRANSCRIBE_API_KEY=""
TRANSCRIBE_MODEL=""
ELEVENLABS_API_KEY=""

# Narration voice. Unset keeps the browser's own voice.
# "elevenlabs" uses ELEVENLABS_API_KEY; clips are cached in .artifacts/narration.
NARRATION_PROVIDER=""
NARRATION_VOICE_ID=""
NARRATION_MODEL="eleven_flash_v2_5"

# Voice agent on the orb. Unset keeps the orb as a local microphone meter.
# "elevenlabs" uses ELEVENLABS_API_KEY and the agent created in your ElevenLabs account.
AGENT_PROVIDER=""
ELEVENLABS_AGENT_ID=""
